---
source: crates/peekbuddy-core/src/filter/presets.rs
expression: "preset.rules(Scope::Global)"
---
[
    Rule {
        scope: Global,
        pattern: Glob(
            "node_modules/",
        ),
        polarity: Exclude,
        action: HideInView,
    },
    Rule {
        scope: Global,
        pattern: Glob(
            "target/",
        ),
        polarity: Exclude,
        action: HideInView,
    },
    Rule {
        scope: Global,
        pattern: Glob(
            "build/",
        ),
        polarity: Exclude,
        action: HideInView,
    },
]
